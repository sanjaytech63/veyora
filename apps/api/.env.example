NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
COOKIE_SECRET=veyora_secure_cookie_secret_dev_32chars
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=10mb
LOG_LEVEL=info

# JWT & Auth Security
JWT_ACCESS_SECRET=veyora_jwt_access_secret_super_secure_32chars_min
JWT_REFRESH_SECRET=veyora_jwt_refresh_secret_super_secure_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Database & Cache (Local MongoDB Compass & Docker Redis)
MONGODB_URI=mongodb://127.0.0.1:27017/veyora_dev
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=veyora-cloud
CLOUDINARY_API_KEY=veyora_cloud_api_key_12345
CLOUDINARY_API_SECRET=veyora_cloud_api_secret_67890
CLOUDINARY_UPLOAD_FOLDER=veyora

