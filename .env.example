# ==============================================================================
# Veyora Monorepo Global Environment Configuration (.env.example)
# Copy this file to .env for local development
# ==============================================================================

# Node Environment
NODE_ENV=development

# Service Ports
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
API_PREFIX=/api/v1

# MongoDB Configuration
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=veyora_mongo_dev
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=veyora_dev
MONGODB_URI=mongodb://root:veyora_mongo_dev@127.0.0.1:27017/veyora_dev?authSource=admin

# Redis Configuration (BullMQ & Caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=veyora_redis_dev

# Worker Concurrency
CONCURRENCY=5

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
